/* ==========================================================================
   Catálogo de Productos para Baby Boutique
   ========================================================================== */

let listaProductos = [];

// 1. Cargar el JSON
async function obtenerProductos() {
    try {
        const respuesta = await fetch("data/productos.json");
        if (respuesta.ok) {
            listaProductos = await respuesta.json();
            renderizarProductos(listaProductos);
        } else {
            console.error("No se pudo cargar data/productos.json");
        }
    } catch (error) {
        console.error("Error al leer productos.json:", error);
    }
}

// 2. Obtener la imagen inicial del producto
function obtenerRutaImagen(prod) {
    if (prod.colores && prod.colores.length > 0 && prod.colores[0].imagen) {
        return prod.colores[0].imagen;
    }
    if (prod.imagen) return prod.imagen;
    return "assets/placeholder.jpg";
}

// 3. Renderizar catálogo en HTML
function renderizarProductos(productosAMostrar = []) {
    const contenedor = document.getElementById('products-container') || document.getElementById('grid-productos');
    if (!contenedor) return;

    contenedor.innerHTML = "";

    if (productosAMostrar.length === 0) {
        contenedor.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #6b7280; padding: 40px;">No se encontraron productos en esta categoría.</p>';
        return;
    }

    productosAMostrar.forEach(prod => {
        const tarjeta = document.createElement('div');
        tarjeta.className = 'product-card';

        const idUnico = prod.id || prod.codigo;
        const imagenRuta = obtenerRutaImagen(prod);
        const listaTallas = (prod.tallas && prod.tallas.length > 0) ? prod.tallas : ["Talla Única"];

        // Construcción de opciones para colores
        let opcionesColores = '';
        if (prod.colores && prod.colores.length > 0) {
            prod.colores.forEach(c => {
                opcionesColores += '<option value="' + c.nombre + '" data-img="' + c.imagen + '">' + c.nombre + '</option>';
            });
        }

        // Construcción de opciones para tallas
        let opcionesTallas = '';
        listaTallas.forEach(t => {
            opcionesTallas += '<option value="' + t + '">' + t + '</option>';
        });

        // HTML interno de la tarjeta
        let htmlTarjeta = '';
        htmlTarjeta += '<a href="producto.html?id=' + idUnico + '">';
        htmlTarjeta += '  <img id="img-' + idUnico + '" src="' + imagenRuta + '" alt="' + prod.nombre + '" style="width:100%; height:220px; object-fit:cover; border-radius:8px;" onerror="this.src=\'assets/placeholder.jpg\'">';
        htmlTarjeta += '</a>';
        htmlTarjeta += '<div class="producto-info" style="padding: 15px;">';
        htmlTarjeta += '  <span style="font-size: 0.8rem; color: #9ca3af; font-weight: bold;">CÓDIGO: ' + prod.codigo + '</span>';
        htmlTarjeta += '  <h3 style="font-size: 1rem; color: #1f2937; margin: 5px 0;">' + prod.nombre + '</h3>';

        if (opcionesColores !== '') {
            htmlTarjeta += '  <label style="display:block; font-size: 0.8rem; margin-top: 8px;">Color:</label>';
            htmlTarjeta += '  <select id="color-' + idUnico + '" onchange="cambiarImagenColor(\'' + idUnico + '\')" style="width: 100%; padding: 6px; border-radius: 6px; border: 1px solid #ddd; margin-bottom: 8px;">' + opcionesColores + '</select>';
        }

        htmlTarjeta += '  <label style="display:block; font-size: 0.8rem;">Talla:</label>';
        htmlTarjeta += '  <select id="talla-' + idUnico + '" style="width: 100%; padding: 6px; border-radius: 6px; border: 1px solid #ddd; margin-bottom: 8px;">' + opcionesTallas + '</select>';

        htmlTarjeta += '  <label style="display:block; font-size: 0.8rem;">Cantidad:</label>';
        htmlTarjeta += '  <input type="number" id="cantidad-' + idUnico + '" min="0" value="0" style="width: 100%; padding: 6px; border-radius: 6px; border: 1px solid #ddd; margin-bottom: 12px;">';

        htmlTarjeta += '  <div style="text-align: center; background: #fff1f2; padding: 8px; border-radius: 8px; margin-bottom: 12px;">';
        htmlTarjeta += '    <span style="font-size: 1.2rem; font-weight: bold; color: #db2777;">$' + Number(prod.precio).toFixed(2) + '</span>';
        if (prod.precioMediaDocena) {
            htmlTarjeta += '    <p style="font-size: 0.75rem; color: #e11d48; margin: 0;">P. Mayorista: $' + Number(prod.precioMediaDocena).toFixed(2) + '</p>';
        }
        htmlTarjeta += '  </div>';

        htmlTarjeta += '  <button onclick="prepararAgregar(\'' + idUnico + '\')" style="width: 100%; background: #db2777; color: white; border: none; padding: 10px; border-radius: 8px; font-weight: 600; cursor: pointer;">🛒 Añadir al Carrito</button>';
        htmlTarjeta += '</div>';

        tarjeta.innerHTML = htmlTarjeta;
        contenedor.appendChild(tarjeta);
    });
}

// 4. Cambiar foto según el color seleccionado
function cambiarImagenColor(idProducto) {
    const selectColor = document.getElementById('color-' + idProducto);
    const imgElem = document.getElementById('img-' + idProducto);
    if (selectColor && imgElem) {
        const opcion = selectColor.options[selectColor.selectedIndex];
        const nuevaRuta = opcion.getAttribute('data-img');
        if (nuevaRuta) {
            imgElem.src = nuevaRuta;
        }
    }
}

// 5. Función para mandar al carrito
function prepararAgregar(idProducto) {
    const prod = listaProductos.find(p => p.id === idProducto || p.codigo === idProducto);
    if (!prod) return;

    const colorSelect = document.getElementById('color-' + idProducto);
    const tallaSelect = document.getElementById('talla-' + idProducto);
    const cantidadInput = document.getElementById('cantidad-' + idProducto);

    const cantidad = cantidadInput ? parseInt(cantidadInput.value) || 0 : 0;

    if (cantidad <= 0) {
        alert("Selecciona al menos 1 unidad para agregar.");
        return;
    }

    const imgElem = document.getElementById('img-' + idProducto);

    const productoAAgregar = {
        id: prod.id,
        codigo: prod.codigo,
        nombre: prod.nombre,
        precio: prod.precio,
        precioMediaDocena: prod.precioMediaDocena,
        precioDocena: prod.precioDocena,
        imagen: imgElem ? imgElem.src : '',
        color: colorSelect ? colorSelect.value : 'Único',
        talla: tallaSelect ? tallaSelect.value : 'Única',
        cantidad: cantidad
    };

    if (typeof agregarAlCarrito === 'function') {
        agregarAlCarrito(productoAAgregar);
    }
}

// 6. Filtros por botones de categoría
function inicializarFiltros() {
    const botones = document.querySelectorAll('.cat-btn');
    botones.forEach(btn => {
        btn.addEventListener('click', (e) => {
            botones.forEach(b => b.classList.remove('active'));
            e.currentTarget.classList.add('active');

            const categoriaFiltro = e.currentTarget.getAttribute('data-category').trim().toLowerCase();

            if (categoriaFiltro === 'todos' || categoriaFiltro === 'todas') {
                renderizarProductos(listaProductos);
            } else {
                const filtrados = listaProductos.filter(p => (p.categoria || '').trim().toLowerCase() === categoriaFiltro);
                renderizarProductos(filtrados);
            }
        });
    });
}

document.addEventListener('DOMContentLoaded', () => {
    obtenerProductos();
    inicializarFiltros();
});
