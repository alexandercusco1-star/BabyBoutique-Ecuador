/* ==========================================================================
   Catálogo Integrado con productos.json
   ========================================================================== */

let listaProductos = [];

// 1. Cargar el JSON
async function obtenerProductos() {
    try {
        const respuesta = await fetch("data/productos.json");
        if (respuesta.ok) {
            listaProductos = await respuesta.json();
            renderizarProductos(listaProductos);
        } else {
            console.error("Error: No se encuentra data/productos.json");
        }
    } catch (error) {
        console.error("Error al leer productos.json:", error);
    }
}

// 2. Extraer ruta de imagen primaria
function obtenerRutaImagen(prod) {
    if (prod.colores && prod.colores.length > 0 && prod.colores[0].imagen) {
        return prod.colores[0].imagen;
    }
    if (prod.imagen) return prod.imagen;
    return './img/placeholder.jpg';
}

// 3. Renderizar las tarjetas
function renderizarProductos(productosAMostrar = []) {
    const contenedor = document.getElementById('products-container') || document.getElementById('grid-productos');
    if (!contenedor) return;

    contenedor.innerHTML = '';

    if (productosAMostrar.length === 0) {
        contenedor.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: #6b7280; padding: 40px;">No se encontraron productos en esta categoría.</p>`;
        return;
    }

    productosAMostrar.forEach(prod => {
        const tarjeta = document.createElement('div');
        tarjeta.className = 'product-card';

        const idUnico = prod.id || prod.codigo;
        const imagenRuta = obtenerRutaImagen(prod);
        const listaTallas = (prod.tallas && prod.tallas.length > 0) ? prod.tallas : ["Talla Única"];

        tarjeta.innerHTML = `
            <a href="producto.html?id=${idUnico}" style="text-decoration: none; color: inherit;">
                <img id="img-${idUnico}" src="${imagenRuta}" alt="${prod.nombre}" style="width:100%; height:220px; object-fit:cover; border-radius:8px;" onerror="this.src='./img/placeholder.jpg'">
            </a>
            <div class="producto-info" style="padding: 15px;">
                <span style="font-size: 0.8rem; color: #9ca3af; font-weight: bold;">CÓDIGO: ${prod.codigo}</span>
                <a href="producto.html?id=${idUnico}" style="text-decoration: none;">
                    <h3 style="font-size: 1rem; color: #1f2937; margin: 5px 0; height: 40px; overflow: hidden;">${prod.nombre}</h3>
                </a>
                
                ${prod.colores && prod.colores.length > 0 ? `
                <label style="display:block; font-size: 0.8rem; margin-top: 8px;">Color:</label>
                <select id="color-${idUnico}" onchange="cambiarImagenColor('${idUnico}')" style="width: 100%; padding: 6px; border-radius: 6px; border: 1px solid #ddd; margin-bottom: 8px;">
                    ${prod.colores.map(c => `<option value="${c.nombre}" data-img="${c.imagen}">${c.nombre}</option>`).join('')}
                </select>` : ''}

                <label style="display:block; font-size: 0.8rem;">Talla:</label>
                <select id="talla-${idUnico}" style="width: 100%; padding: 6px; border-radius: 6px; border: 1px solid #ddd; margin-bottom: 8px;">
                    ${listaTallas.map(t => `<option value="${t}">${t}</option>`).join('')}
                </select>

                <label style="display:block; font-size: 0.8rem;">Cantidad:</label>
                <input type="number" id="cantidad-${idUnico}" min="0" value="0" style="width: 100%; padding: 6px; border-radius: 6px; border: 1px solid #ddd; margin-bottom: 12px;">

                <div style="text-align: center; background: #fff1f2; padding: 8px; border-radius: 8px; margin-bottom: 12px;">
                    <span style="font-size: 1.2rem; font-weight: bold; color: #db2777;">$${prod.precio.toFixed(2)}</span>
                    ${prod.precioMediaDocena ? `<p style="font-size: 0.75rem; color: #e11d48; margin: 0;">P. Mayorista: $${prod.precioMediaDocena.toFixed(2)}</p>` : ''}
                </div>

                <button onclick="prepararAgregar('${idUnico}')" class="btn-primary" style="width: 100%; background: #db2777; color: white; border: none; padding: 10px; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    🛒 Añadir al Carrito
                </button>
            </div>
        `;
        contenedor.appendChild(tarjeta);
    });
}

// 4. Cambiar la foto al cambiar la opción de color
function cambiarImagenColor(idProducto) {
    const selectColor = document.getElementById(`color-${idProducto}`);
    const imgElem = document.getElementById(`img-${idProducto}`);
    if (selectColor && imgElem) {
        const opcionSeleccionada = selectColor.options[selectColor.selectedIndex];
        const nuevaRuta = opcionSeleccionada.getAttribute('data-img');
        if (nuevaRuta) imgElem.src = nuevaRuta;
    }
}

// 5. Preparar y agregar al carrito
function prepararAgregar(idProducto) {
    const prod = listaProductos.find(p => p.id === idProducto || p.codigo === idProducto);
    if (!prod) return;

    const colorSelect = document.getElementById(`color-${idProducto}`);
    const tallaSelect = document.getElementById(`talla-${idProducto}`);
    const cantidadInput = document.getElementById(`cantidad-${idProducto}`);

    const cantidad = cantidadInput ? parseInt(cantidadInput.value) || 0 : 0;

    if (cantidad <= 0) {
        alert("Selecciona al menos 1 unidad para agregar.");
        return;
    }

    const imagenActual = document.getElementById(`img-${idProducto}`).src;

    const productoAAgregar = {
        id: prod.id,
        codigo: prod.codigo,
        nombre: prod.nombre,
        precio: prod.precio,
        precioMediaDocena: prod.precioMediaDocena,
        precioDocena: prod.precioDocena,
        imagen: imagenActual,
        color: colorSelect ? colorSelect.value : 'Único',
        talla: tallaSelect ? tallaSelect.value : 'Única',
        cantidad: cantidad
    };

    if (typeof agregarAlCarrito === 'function') {
        agregarAlCarrito(productoAAgregar);
    }
}

// 6. Filtrado por botones de categoría
function inicializarFiltros() {
    const botones = document.querySelectorAll('.cat-btn');
    botones.forEach(btn => {
        btn.addEventListener('click', (e) => {
            botones.forEach(b => b.classList.remove('active'));
            e.currentTarget.classList.add('active');

            const categoriaFiltro = e.currentTarget.getAttribute('data-category').trim().toLowerCase();

            if (categoriaFiltro === 'todos' || categoriaFiltro === 'todas') {
                renderizarProductos(listaProductos);
            } else {
                const filtrados = listaProductos.filter(p => (p.categoria || '').trim().toLowerCase() === categoriaFiltro);
                renderizarProductos(filtrados);
            }
        });
    });
}

document.addEventListener('DOMContentLoaded', () => {
    obtenerProductos();
    inicializarFiltros();
});
